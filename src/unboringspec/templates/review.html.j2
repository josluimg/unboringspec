{%- macro flag(key) -%}
{%- set f = ir.follow_up.flag_codes.get(key) if ir.follow_up else None -%}
{%- if f -%}<p class="flag">{{ t["flag_" ~ f.code].format(note=f.get("note") or t.no_note) }}</p>{%- endif -%}
{%- endmacro -%}
{%- macro chips(sources) -%}
{%- for s in sources -%}
<button class="src" data-file="{{ s.file }}" data-line="{{ s.line }}" title="{{ s.excerpt }}">{{ s.file }}:{{ s.line }}</button>
{%- endfor -%}
{%- endmacro -%}
{%- macro decision_card(d) -%}
<article class="card decision" data-id="{{ d.id }}" data-key="{{ keys[d.id] }}" data-attention="{{ d.attention.value }}">
  <header>
    <span class="tag tag-{{ d.attention.value }}">{{ t["att_" ~ d.attention.value] }}</span>
    <h3>{{ d.title }}</h3>
  </header>
  {{ flag(keys[d.id]) }}
  <p class="choice">{{ d.choice }}</p>
  {% if d.rationale %}<p class="muted"><strong>{{ t.why }}</strong> {{ d.rationale }}</p>{% endif %}
  {% if d.alternatives %}<p class="muted"><strong>{{ t.instead_of }}</strong> {{ d.alternatives | join(" · ") }}</p>{% endif %}
  {% if d.risk %}<p class="risk-line"><strong>{{ t.risk }}</strong> {{ d.risk }}</p>{% endif %}
  <footer>
    <div class="sources">{{ chips(d.sources) }}</div>
    <div class="verdict" role="group" aria-label="{{ t.verdict_for.format(title=d.title) }}">
      <button class="v" data-v="approve">{{ t.approve }}</button>
      <button class="v" data-v="question">{{ t.question }}</button>
    </div>
  </footer>
  <textarea class="note" placeholder="{{ t.note_placeholder }}" hidden></textarea>
</article>
{%- endmacro -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.add("js");</script>
<style>
/* Without JavaScript (e.g. a static HTML preview) the interactive parts cannot work:
   hide them instead of showing dead buttons, and show diagram sources as text. */
html:not(.js) .verdict, html:not(.js) .note, html:not(.js) .answer, html:not(.js) .bar { display: none !important; }
html:not(.js) .src { cursor: default; }
html:not(.js) .diagram-src[hidden] { display: block; font: .78rem/1.5 ui-monospace, Menlo, monospace; white-space: pre-wrap; }
.nojs { margin: 0 0 20px; padding: 12px 16px; border-radius: 12px; background: #fff6db; color: #7a5200; font-size: .92rem; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .nojs { background: #352c14; color: #f5c451; } }
:root[data-theme="dark"] .nojs { background: #352c14; color: #f5c451; }
</style>
<title>{{ ir.feature }} · unboringspec</title>
<style>
/* Default tokens (unboringspec.theme.TOKENS). A project's unboring.css overrides them. */
:root { {{ tokens_light|safe }} }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { {{ tokens_dark|safe }} }
}
/* A page that embeds the review (like the demo) can force a theme with data-theme on <html>. */
:root[data-theme="dark"] { {{ tokens_dark|safe }} }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink);
  font: 16px/1.6 var(--font); }
main { max-width: 860px; margin: 0 auto; padding: 32px 16px 120px; }
h1 { font-size: 1.9rem; line-height: 1.2; margin: 0 0 8px; letter-spacing: -0.02em; }
h2 { font-size: 1.15rem; margin: 48px 0 12px; letter-spacing: -0.01em; }
h3 { font-size: 1rem; margin: 0; }
.meta { color: var(--muted); font-size: .85rem; display: flex; flex-wrap: wrap; gap: 8px 16px; }
.pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
.pill { background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 2px 12px; font-size: .85rem; }
.pill b { color: var(--accent); }
.tldr { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 24px; margin-top: 24px; }
.tldr .one { font-size: 1.2rem; font-weight: 600; margin: 0 0 12px; }
.tldr ul { margin: 0; padding-left: 20px; }
.callout { background: var(--decide-soft); border-radius: var(--radius); padding: 16px 20px; }
.callout.warn { background: var(--review-soft); color: var(--review); margin: 16px 0 0; font-size: .9rem; }
.listen { background: var(--accent-soft); border-radius: var(--radius); padding: 16px 20px; margin-top: 16px; }
.listen-title { font-weight: 600; margin: 0 0 8px; }
.listen audio { width: 100%; }
.listen details { background: var(--surface); margin: 12px 0 0; }
.turn { margin: 8px 0; font-size: .95rem; }
.turn strong { display: inline-block; min-width: 4.5em; }
.turn-guide strong { color: var(--accent); }
.turn-skeptic strong { color: var(--review); }
.diagram-canvas { overflow-x: auto; margin-top: 10px; }
.diagram-canvas svg { max-width: 100%; height: auto; }
.diagram-canvas.drawn { cursor: zoom-in; }
.diagram-hint { color: var(--muted); font-size: .8rem; margin: 4px 0 0; }
.diagram-canvas.zoomed { position: fixed; inset: 0; z-index: 30; margin: 0; padding: 24px; overflow: auto;
  background: var(--surface); cursor: zoom-out; }
.diagram-canvas.zoomed svg { max-width: none !important; width: auto; height: auto; }
.diagram-fallback { font: .78rem/1.5 var(--mono); white-space: pre-wrap; background: var(--bg); border-radius: 8px; padding: 10px; }
.changes { border: 1px solid var(--accent); border-radius: var(--radius); padding: 16px 20px; margin-top: 20px; background: var(--surface); }
.changes-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px; }
.change-area { font-weight: 600; margin: 14px 0 4px; }
.change-list { list-style: none; padding: 0; margin: 0; }
.change-list li { padding: 6px 0; border-top: 1px solid var(--line); font-size: .93rem; }
.change-list li:first-child { border-top: 0; }
.delta { margin: 4px 0 2px; font-size: .88rem; }
.delta del { display: block; color: var(--decide); }
.delta ins { display: block; color: var(--routine); text-decoration: none; }
.was { font: .75rem var(--mono); color: var(--muted); }
.tag-chg-added, .tag-chg-resolved, .tag-chg-completed { background: var(--routine-soft); color: var(--routine); }
.tag-chg-changed { background: var(--review-soft); color: var(--review); }
.tag-chg-removed, .tag-chg-reopened { background: var(--decide-soft); color: var(--decide); }
.followup { border: 1px solid var(--review); border-radius: var(--radius); padding: 16px 20px; margin-top: 16px; background: var(--surface); }
.fu-icon { display: inline-block; width: 1.4em; }
.flag { margin: 0 0 8px; padding: 6px 10px; border-radius: 8px; background: var(--review-soft); color: var(--review); font-size: .88rem; }
.carried-badge { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-left: auto; }
.callout ol { margin: 8px 0 0; padding-left: 20px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 20px; margin: 12px 0; }
.card header { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.card footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
.card p { margin: 4px 0; }
.card.is-approve { border-color: var(--routine); }
.card.is-question { border-color: var(--review); }
.choice { font-size: 1.02rem; }
.muted { color: var(--muted); font-size: .92rem; }
.risk-line { color: var(--decide); font-size: .92rem; }
.tag { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; border-radius: 6px; padding: 2px 8px; }
.tag-decide, .tag-high { background: var(--decide-soft); color: var(--decide); }
.tag-review, .tag-medium { background: var(--review-soft); color: var(--review); }
.tag-change-added { background: var(--routine-soft); color: var(--routine); }
.tag-change-modified { background: var(--review-soft); color: var(--review); }
.tag-change-removed { background: var(--decide-soft); color: var(--decide); }
.tag-change-renamed { background: var(--accent-soft); color: var(--accent); }
.tag-routine, .tag-low { background: var(--routine-soft); color: var(--routine); }
.src { font: .75rem var(--mono); background: var(--accent-soft); color: var(--accent); border: 0; border-radius: 6px; padding: 2px 8px; margin: 2px 4px 2px 0; cursor: pointer; }
.src:hover { text-decoration: underline; }
.verdict { display: flex; gap: 6px; }
.v { font: inherit; font-size: .85rem; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 4px 12px; cursor: pointer; }
.v[aria-pressed="true"][data-v="approve"] { background: var(--routine-soft); border-color: var(--routine); color: var(--routine); }
.v[aria-pressed="true"][data-v="question"] { background: var(--review-soft); border-color: var(--review); color: var(--review); }
textarea { width: 100%; margin-top: 10px; min-height: 64px; font: inherit; font-size: .92rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
details { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 20px; margin: 10px 0; }
details > summary { cursor: pointer; font-weight: 600; }
details[open] > summary { margin-bottom: 8px; }
.tasks { list-style: none; padding: 0; margin: 0; }
.tasks li { display: flex; gap: 10px; align-items: baseline; padding: 4px 0; border-top: 1px solid var(--line); font-size: .92rem; }
.tasks li:first-child { border-top: 0; }
.tid { font: .78rem var(--mono); color: var(--muted); min-width: 44px; }
.par { font-size: .7rem; color: var(--accent); border: 1px solid var(--accent); border-radius: 4px; padding: 0 4px; }
.done { text-decoration: line-through; color: var(--muted); }
.empty { color: var(--muted); font-style: italic; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 1px solid var(--line); }
.bar .in { max-width: 860px; margin: 0 auto; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.progress { font-size: .9rem; color: var(--muted); }
.bar-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.secondary { font: inherit; font-weight: 600; background: transparent; color: var(--accent); border: 1px solid var(--accent); border-radius: 8px; padding: 8px 14px; cursor: pointer; }
.primary { font: inherit; font-weight: 600; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 8px; padding: 8px 16px; cursor: pointer; }
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(640px, 100%); background: var(--surface); border-left: 1px solid var(--line);
  transform: translateX(100%); transition: transform .2s ease; display: flex; flex-direction: column; z-index: 10; }
.drawer.open { transform: none; }
.drawer header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--line); font: .9rem var(--mono); }
.drawer pre { margin: 0; overflow: auto; flex: 1; font: .8rem/1.55 var(--mono); padding: 8px 0; }
.drawer .ln { display: block; padding: 0 16px; white-space: pre-wrap; }
.drawer .ln span { color: var(--muted); display: inline-block; width: 3.5em; user-select: none; }
.drawer .ln.hl { background: var(--hl); }
.x { font-size: 1.2rem; background: none; border: 0; color: var(--ink); cursor: pointer; }
</style>
{%- if theme_css %}
<style id="unboring-theme">
/* {{ theme_name }} */
{{ theme_css|safe }}
</style>
{%- endif %}
</head>
<body>
<main>
  <noscript><p class="nojs">{{ t.nojs | safe }}</p></noscript>
  <div class="meta">
    <span>{{ ir.framework }}</span>
    <span>{{ t.generated_by.format(who=t.get("who_" ~ ir.generated_by, ir.generated_by)) }}</span>
    <span>unboringspec {{ version }}</span>
  </div>
  <h1>{{ ir.feature }}</h1>
  <div class="pills">
    {% set req_label = t.pill_requirement_changes if ir.requirements | selectattr("change") | list else t.pill_requirements %}
    {% for count, label in [(ir.stories | length, t.pill_stories), (ir.requirements | length, req_label), (ir.decisions | length, t.pill_decisions), (ir.tasks | length, t.pill_tasks), (ir.questions | length, t.pill_questions)] if count %}
    <span class="pill"><b>{{ count }}</b> {{ label }}</span>
    {% endfor %}
  </div>

  {% if ir.changes %}
  <section class="changes" aria-label="{{ changes_title }}">
    <p class="changes-title">{{ changes_title }}</p>
    {% if ir.changes.items %}
    <p class="muted">{{ change_summary }}{% if ir.changes.files %} · {% for f in ir.changes.files %}{{ f.file }} {% if f.status == "added" %}{{ t.file_new }}{% elif f.status == "removed" %}{{ t.file_deleted }}{% else %}+{{ f.added }} −{{ f.removed }}{% endif %}{{ ", " if not loop.last }}{% endfor %}{% endif %}</p>
    {% for area, items in change_areas %}
    <p class="change-area">{{ t.get("area_" ~ area, area) }}</p>
    <ul class="change-list">
      {% for c in items %}
      <li>
        <span class="tag tag-chg-{{ c.change }}">{{ t.get("chg_" ~ c.change, c.change) }}</span> <strong>{{ c.label }}</strong>
        {% if c.before or c.after %}<div class="delta">{% if c.before %}<del>{{ c.before }}</del>{% endif %}{% if c.after %}<ins>{{ c.after }}</ins>{% endif %}</div>{% endif %}
        <div class="sources">{{ chips(c.sources) }}{% if c.was_at %}<span class="was">{{ t.was_at.format(where=c.was_at) }}</span>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
    {% endfor %}
    {% else %}
    <p class="muted">{{ t.nothing_changed }}{% if ir.changes.files %}{{ t.only_wording.format(files=ir.changes.files | map(attribute="file") | join(", ")) }}{% endif %}.</p>
    {% endif %}
    {% for n in ir.changes.notes %}<p class="muted"><em>{{ note(n) }}</em></p>{% endfor %}
  </section>
  {% endif %}

  {% if ir.follow_up and ir.follow_up.items %}
  {% set icons = {"approved-changed": "⚠️", "changed": "🔎", "not-addressed": "⏳", "pending": "⏳",
    "addressed": "✅", "removed": "➖", "approved": "✓"} %}
  {% set open_items = ir.follow_up.items | rejectattr("outcome", "equalto", "approved") | list %}
  {% set still = ir.follow_up.items | selectattr("outcome", "equalto", "approved") | list %}
  <section class="followup" aria-label="{{ t.followup_title }}">
    <p class="changes-title">{{ t.followup_title }}</p>
    <p class="muted">{{ t.followup_intro.format(when=ir.follow_up.reviewed_at or ir.follow_up.reviewed) }}</p>
    <ul class="change-list">
      {% for i in open_items %}
      <li class="fu-{{ i.outcome }}">
        <span class="fu-icon">{{ icons[i.outcome] }}</span> <strong>{{ i.label }}</strong>
        <span class="muted">· {{ t["out_" ~ i.outcome] }}</span>
        {% if i.reader_said %}<div class="delta"><span class="muted">{{ t.you_said }}</span> {{ i.reader_said }}</div>{% endif %}
        <div class="sources">{{ chips(i.sources) }}</div>
      </li>
      {% endfor %}
    </ul>
    {% if still %}<p class="muted">{{ (t.still_hold_one if still | length == 1 else t.still_hold_many).format(n=still | length, list=still | map(attribute="label") | join(", ")) }}</p>{% endif %}
    {% for n in ir.follow_up.notes %}<p class="muted"><em>{{ note(n) }}</em></p>{% endfor %}
  </section>
  {% endif %}

  {% for w in ir.warnings %}
  <p class="callout warn">⚠ {{ w }}</p>
  {% endfor %}

  {% if ir.summary %}
  <section class="tldr" aria-label="Summary">
    <p class="one">{{ ir.summary.one_liner }}</p>
    <ul>{% for b in ir.summary.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if podcast %}
  <section class="listen" aria-label="Podcast">
    <p class="listen-title">{{ t.listen }} · {{ podcast.title }}{% if podcast.tone_id %} <span class="tag tag-routine">{{ t.get("tone_" ~ podcast.tone_id, t.tone_custom) }}</span>{% endif %}</p>
    {% if podcast.stale %}
    <p class="flag stale-episode">
      {% if podcast.known_version %}{{ t.stale_known }}{% if podcast.changes %}{{ (t.stale_since_one if podcast.changes == 1 else t.stale_since_many).format(n=podcast.changes) }}{% endif %}.
      {% else %}{{ t.stale_unknown }}
      {% endif %}{{ t.record_new.format(cmd="<code>/unboring-podcast</code>") | safe }}
    </p>
    {% endif %}
    <audio controls preload="metadata" src="{{ podcast.audio }}"></audio>
    <details>
      <summary>{{ t.transcript }}</summary>
      {% for turn in podcast.turns %}
      {# A stale transcript cites lines of an older version: no links, they would point at the wrong text. #}
      <p class="turn turn-{{ turn.role }}"><strong>{{ turn.name }}</strong> {{ turn.text }} {% if not podcast.stale %}{{ chips(turn.sources) }}{% endif %}</p>
      {% endfor %}
    </details>
  </section>
  {% endif %}

  <h2>1 · {{ t.h_judgment }}</h2>
  {% if ir.questions or decide %}
  <div class="callout">
    {{ t.judgment_callout }}
  </div>
  {% for q in ir.questions %}
  <article class="card question" data-qid="{{ q.id }}" data-key="{{ keys[q.id] }}">
    {{ flag(keys[q.id]) }}
    <header><span class="tag tag-decide">{{ q.id }}</span><h3>{{ q.question }}</h3></header>
    {% if q.why_it_matters %}<p class="muted">{{ q.why_it_matters }}</p>{% endif %}
    <div class="sources">{{ chips(q.sources) }}</div>
    <textarea class="answer" placeholder="{{ t.answer_placeholder }}"></textarea>
  </article>
  {% endfor %}
  {% for d in decide %}{{ decision_card(d) }}{% endfor %}
  {% else %}
  <p class="empty">{{ t.nothing_blocked }}</p>
  {% endif %}

  <h2>2 · {{ t.h_decisions }}</h2>
  {% for d in review %}{{ decision_card(d) }}{% else %}<p class="empty">{{ t.no_debatable }}</p>{% endfor %}
  {% if routine %}
  <details>
    <summary>{{ t.routine_n.format(n=routine | length) }}</summary>
    {% for d in routine %}{{ decision_card(d) }}{% endfor %}
  </details>
  {% endif %}

  {% set ns = namespace(n=2) %}
  {% if ir.risks %}
  {% set ns.n = ns.n + 1 %}
  <h2>{{ ns.n }} · {{ t.h_risks }}</h2>
  {% for r in ir.risks %}
  <article class="card">
    <header><span class="tag tag-{{ r.severity }}">{{ t["sev_" ~ r.severity] }}</span><h3>{{ r.title }}</h3></header>
    {% if r.impact %}<p class="muted"><strong>{{ t.impact }}</strong> {{ r.impact }}</p>{% endif %}
    {% if r.mitigation %}<p class="muted"><strong>{{ t.mitigation }}</strong> {{ r.mitigation }}</p>{% endif %}
    <div class="sources">{{ chips(r.sources) }}</div>
  </article>
  {% endfor %}
  {% endif %}

  {% if diagrams %}
  {% set ns.n = ns.n + 1 %}
  <h2>{{ ns.n }} · {{ t.h_visual }}</h2>
  {% for d in diagrams %}
  {# The first diagram is the starting point (usually the system map), so it comes open. #}
  <details class="diagram" data-kind="{{ d.kind }}"{% if loop.first %} open{% endif %}>
    <summary>{{ d.title }} <span class="tag tag-{{ 'routine' if d.origin == 'spec' else 'review' }}">{{ t.from_spec if d.origin == 'spec' else t.by_agent }}</span></summary>
    <div class="sources">{{ chips(d.sources) }}</div>
    <div class="diagram-canvas"></div>
    <pre class="diagram-src" hidden>{{ d.mermaid }}</pre>
  </details>
  {% endfor %}
  {% endif %}

  {% set ns.n = ns.n + 1 %}
  <h2>{{ ns.n }} · {{ t.h_scope }}</h2>
  {% for sid, tasks in tasks_by_story.items() %}
  {% set s = stories.get(sid) %}
  <details>
    <summary>{% if s %}{{ s.priority }} {{ s.title }}{% elif sid == "Shared" %}{{ t.shared }}{% else %}{{ sid }}{% endif %} · {{ t.n_tasks.format(n=tasks | length) }}</summary>
    {% if s and s.summary %}<p class="muted">{{ s.summary }}</p>{% endif %}
    <ul class="tasks">
    {% for task in tasks %}
      <li><span class="tid">{{ task.id }}</span><span class="{{ 'done' if task.done }}">{{ task.text }}</span>{% if task.parallel %}<span class="par">P</span>{% endif %}</li>
    {% endfor %}
    </ul>
  </details>
  {% endfor %}
  {% for s in ir.stories if s.id not in tasks_by_story %}
  <details><summary>{{ s.priority }} {{ s.title }} · {{ t.no_tasks }}</summary><p class="muted">{{ s.summary }}</p></details>
  {% endfor %}
  {% if ir.requirements %}
  <details>
    <summary>{{ ir.requirements | length }} {{ req_label }}</summary>
    <ul class="tasks">
    {% for r in ir.requirements %}<li><span class="tid">{{ r.id }}</span>{% if r.change %}<span class="tag tag-change-{{ r.change }}">{{ t.get("req_" ~ r.change, r.change) }}</span>{% endif %}<span>{{ r.text }}</span></li>{% endfor %}
    </ul>
  </details>
  {% endif %}
</main>

<div class="bar"><div class="in">
  <span class="progress" id="progress"></span>
  <span class="bar-actions">
    <button class="secondary" id="copy" title="{{ t.copy_title }}">{{ t.copy_button }}</button>
    <button class="primary" id="export">{{ t.export }}</button>
  </span>
</div></div>

<aside class="drawer" id="drawer" aria-hidden="true">
  <header><span id="drawer-title"></span><button class="x" id="drawer-close" aria-label="{{ t.close }}">×</button></header>
  <pre id="drawer-body"></pre>
</aside>

<script id="data" type="application/json">{{ payload | safe }}</script>
<script>
(() => {
  const data = JSON.parse(document.getElementById("data").textContent);
  const ui = data.ui;  // the page's strings in its language (i18n.py)
  const fill = (s, vars) => s.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? vars[k] : m));
  // Marks are saved per item identity (data-key), never per position (D1, Q2...), which is
  // reassigned on every render (#29). Old position-based marks cannot be mapped safely, so the
  // previous storage entry is dropped instead of being applied to whatever now sits in that slot.
  const key = "unboringspec:v2:" + data.feature;
  let state = {};
  try {
    localStorage.removeItem("unboringspec:" + data.feature);
    state = JSON.parse(localStorage.getItem(key) || "{}");
  } catch (e) {}
  // Marks carried over from the last saved review fill the gaps; what the reader did in this
  // browser wins. A carried mark stops being "carried" as soon as the reader touches it.
  Object.entries(data.carried || {}).forEach(([k, mark]) => {
    if (!state[k]) state[k] = Object.assign({ carried: true }, mark);
  });
  const save = () => { try { localStorage.setItem(key, JSON.stringify(state)); } catch (e) {} updateProgress(); };

  // Verdicts on decision cards
  document.querySelectorAll(".decision").forEach(card => {
    const id = card.dataset.key, note = card.querySelector(".note");
    const apply = () => {
      const s = state[id] || {};
      card.classList.toggle("is-approve", s.v === "approve");
      card.classList.toggle("is-question", s.v === "question");
      card.querySelectorAll(".v").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.v === s.v)));
      note.hidden = s.v !== "question";
      note.value = s.note || "";
      let badge = card.querySelector(".carried-badge");
      if (s.carried && s.v) {
        if (!badge) { badge = document.createElement("span"); badge.className = "carried-badge"; card.querySelector("header").appendChild(badge); }
        badge.textContent = ui.js_from_last_review;
      } else if (badge) badge.remove();
    };
    card.querySelectorAll(".v").forEach(b => b.addEventListener("click", () => {
      const s = state[id] || {};
      s.v = s.v === b.dataset.v ? undefined : b.dataset.v;
      delete s.carried;
      state[id] = s; save(); apply();
      if (s.v === "question") note.focus();
    }));
    note.addEventListener("input", () => { (state[id] = state[id] || {}).note = note.value; delete state[id].carried; save(); });
    apply();
  });

  // Answers to open questions
  document.querySelectorAll(".question").forEach(card => {
    const id = card.dataset.key, ta = card.querySelector(".answer");
    ta.value = (state[id] || {}).answer || "";
    ta.addEventListener("input", () => { (state[id] = state[id] || {}).answer = ta.value; delete state[id].carried; save(); });
  });

  function updateProgress() {
    const ids = data.decisions.map(d => d.key).concat(data.questions.map(q => q.key));
    const marked = id => state[id] && (state[id].v || (state[id].answer || "").trim());
    const done = ids.filter(marked).length;
    const carried = ids.filter(id => marked(id) && state[id].carried).length;
    document.getElementById("progress").textContent =
      fill(ui.js_progress, { done, total: ids.length }) + (carried ? fill(ui.js_progress_carried, { n: carried }) : "");
  }
  updateProgress();

  // Source drawer: every claim links back to the exact line
  const drawer = document.getElementById("drawer");
  document.querySelectorAll(".src").forEach(b => b.addEventListener("click", () => {
    const file = b.dataset.file, line = +b.dataset.line;
    const lines = (data.documents[file] || "").split("\n");
    const pre = document.getElementById("drawer-body");
    pre.replaceChildren(...lines.map((t, i) => {
      const el = document.createElement("span");
      el.className = "ln" + (i + 1 === line ? " hl" : "");
      const n = document.createElement("span"); n.textContent = i + 1;
      el.append(n, t);
      return el;
    }));
    document.getElementById("drawer-title").textContent = `${file}:${line}`;
    drawer.classList.add("open"); drawer.setAttribute("aria-hidden", "false");
    const target = pre.children[line - 1];
    if (target) target.scrollIntoView({ block: "center" });
  }));
  const close = () => { drawer.classList.remove("open"); drawer.setAttribute("aria-hidden", "true"); };
  document.getElementById("drawer-close").addEventListener("click", close);
  document.addEventListener("keydown", e => { if (e.key === "Escape") close(); });

  // Diagrams: Mermaid loads on the first open, so closed diagrams cost nothing. Spec-built
  // diagrams need no LLM; drawing them needs Mermaid from the CDN, and without it the source shows.
  const MERMAID = "https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs";
  let mermaidReady;
  const isDark = () => {
    const forced = document.documentElement.dataset.theme;
    return forced ? forced === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  };
  // With a project theme, diagrams take their colours and font from the page's tokens.
  const themed = !!document.getElementById("unboring-theme");
  const token = name => getComputedStyle(document.documentElement).getPropertyValue("--" + name).trim();
  const themeVariables = () => ({
    darkMode: isDark(), fontFamily: token("font"), background: token("surface"),
    primaryColor: token("accent-soft"), primaryBorderColor: token("accent"), primaryTextColor: token("ink"),
    secondaryColor: token("bg"), tertiaryColor: token("surface"), lineColor: token("muted"), textColor: token("ink"),
    mainBkg: token("accent-soft"), nodeBorder: token("accent"), clusterBkg: token("bg"), clusterBorder: token("line"),
    edgeLabelBackground: token("surface"), actorBkg: token("accent-soft"), actorBorder: token("accent"),
    actorTextColor: token("ink"), signalColor: token("ink"), signalTextColor: token("ink"), noteBkgColor: token("review-soft"),
    noteTextColor: token("ink"), noteBorderColor: token("review"),
    attributeBackgroundColorOdd: token("surface"), attributeBackgroundColorEven: token("bg"),
  });
  const setup = mermaid => mermaid.initialize({
    startOnLoad: false, securityLevel: "strict",
    ...(themed ? { theme: "base", themeVariables: themeVariables() } : { theme: isDark() ? "dark" : "default" }),
    flowchart: { subGraphTitleMargin: { top: 6, bottom: 10 } },
  });
  const loadMermaid = () => mermaidReady || (mermaidReady = import(MERMAID).then(m => {
    setup(m.default);
    return m.default;
  }));
  const draw = async (d, i) => {
    if (!d.open || d.dataset.drawn) return;
    d.dataset.drawn = "1";
    const run = d._run = (d._run || 0) + 1;  // a newer draw (e.g. after a theme change) wins
    const stale = () => d._run !== run;
    const canvas = d.querySelector(".diagram-canvas");
    const src = d.querySelector(".diagram-src").textContent;
    const fallback = msg => {
      canvas.textContent = msg;
      const pre = document.createElement("pre");
      pre.className = "diagram-fallback";
      pre.textContent = src;
      canvas.appendChild(pre);
    };
    canvas.textContent = ui.js_drawing;
    let mermaid;
    try { mermaid = await loadMermaid(); } catch (e) { mermaidReady = null; return stale() || fallback(ui.js_mermaid_offline); }
    try {
      await mermaid.parse(src);
      const { svg } = await mermaid.render("diagram-" + i, src);
      if (stale()) return;
      canvas.innerHTML = svg;
      d.querySelector(".diagram-hint")?.remove();
      canvas.classList.add("drawn");
      canvas.title = ui.js_click_enlarge;
      const hint = document.createElement("p");
      hint.className = "diagram-hint";
      hint.textContent = ui.js_enlarge_hint;
      canvas.after(hint);
      d.dataset.rendered = "1";
    } catch (e) {
      if (stale()) return;
      fallback(ui.js_diagram_failed);
      d.dataset.failed = "1";
    }
  };
  // When the theme changes (system setting, or data-theme set by an embedding page),
  // drawn diagrams are drawn again in the new colours.
  const redraw = async () => {
    if (!mermaidReady) return;
    setup(await mermaidReady);
    document.querySelectorAll("details.diagram").forEach((d, i) => {
      if (!d.dataset.drawn) return;
      const canvas = d.querySelector(".diagram-canvas");
      canvas.classList.remove("drawn", "zoomed");
      canvas.removeAttribute("title");
      d.querySelector(".diagram-hint")?.remove();
      delete d.dataset.drawn; delete d.dataset.rendered; delete d.dataset.failed;
      draw(d, i);
    });
  };
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", redraw);
  new MutationObserver(redraw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  document.querySelectorAll("details.diagram").forEach((d, i) => {
    d.addEventListener("toggle", () => draw(d, i));
    draw(d, i);  // diagrams that start open
    const canvas = d.querySelector(".diagram-canvas");
    canvas.addEventListener("click", () => {
      if (!canvas.classList.contains("drawn")) return;
      const zoomed = canvas.classList.toggle("zoomed");
      // Mermaid sizes the SVG to its container; full size means its own viewBox width.
      const svg = canvas.querySelector("svg");
      svg.style.width = zoomed && svg.viewBox.baseVal ? svg.viewBox.baseVal.width + "px" : "";
    });
  });
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    document.querySelectorAll(".diagram-canvas.zoomed").forEach(c => {
      c.classList.remove("zoomed");
      c.querySelector("svg").style.width = "";
    });
  });

  // Export: structured feedback the agent can consume (e.g. in /speckit.clarify), plus a hidden
  // machine-readable block so the next render can follow it up (unboring feedback, #28).
  function buildReview() {
    const out = [`# ${fill(ui.js_review_title, { feature: data.feature })}`, "",
      `_${fill(ui.js_generated_with, { date: new Date().toISOString().slice(0, 10) })}_`, ""];
    if (data.apply_hint) out.push(`> ${data.apply_hint}`, "");
    const answered = data.questions.filter(q => ((state[q.key] || {}).answer || "").trim());
    if (answered.length) {
      out.push(`## ${ui.js_answers_h}`, "");
      answered.forEach(q => out.push(`- **${q.id}** ${q.question}`, `  - ${ui.js_answer}: ${state[q.key].answer.trim()}`));
      out.push("");
    }
    const qd = data.decisions.filter(d => (state[d.key] || {}).v === "question");
    if (qd.length) {
      out.push(`## ${ui.js_revisit_h}`, "");
      qd.forEach(d => out.push(`- **${d.id} ${d.title}**: ${d.choice}`, `  - ${ui.js_reviewer}: ${(state[d.key].note || ui.js_no_comment).trim()}`));
      out.push("");
    }
    const ok = data.decisions.filter(d => (state[d.key] || {}).v === "approve");
    if (ok.length) {
      out.push(`## ${ui.js_approved_h}`, "");
      ok.forEach(d => out.push(`- ${d.id} ${d.title}: ${d.choice}`));
      out.push("");
    }
    const items = [];
    answered.forEach(q => items.push({ id: q.id, key: q.key, kind: "answer", text: q.question, cite: q.cite, answer: state[q.key].answer.trim() }));
    qd.forEach(d => items.push({ id: d.id, key: d.key, kind: "question", text: d.title, choice: d.choice, cite: d.cite, note: (state[d.key].note || "").trim() }));
    ok.forEach(d => items.push({ id: d.id, key: d.key, kind: "approve", text: d.title, choice: d.choice, cite: d.cite }));
    // "--" cannot appear inside an HTML comment; inside JSON strings it is written as -\u002d.
    const block = JSON.stringify({ version: data.version, feature: data.feature, created: new Date().toISOString(), items })
      .replace(/--/g, "-\\u002d");
    out.push(`<!-- unboring:review ${block} -->`, "");
    return out.join("\n");
  }

  document.getElementById("export").addEventListener("click", () => {
    const blob = new Blob([buildReview()], { type: "text/markdown" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = "review.md"; a.click();
    URL.revokeObjectURL(a.href);
  });

  document.getElementById("copy").addEventListener("click", async e => {
    const text = buildReview();
    const button = e.currentTarget;
    try {
      await navigator.clipboard.writeText(text);
    } catch (err) {  // file:// pages and older browsers
      const ta = document.createElement("textarea");
      ta.value = text; document.body.appendChild(ta); ta.select();
      document.execCommand("copy"); ta.remove();
    }
    const label = button.textContent;
    button.textContent = ui.js_copied;
    setTimeout(() => { button.textContent = label; }, 2500);
  });
})();
</script>
</body>
</html>
